{
  "name": "author-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && esbuild src/documents.ts --bundle --format=esm --target=es2023 --outfile=dist/documents.js",
    "start": "node dist/src/server.js",
    "dev": "npm run build && npm start",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0"
  }
}
